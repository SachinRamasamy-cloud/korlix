component feature-card
  prop title: string
  prop description: string

  card variant=raised
    h3 title
    p description

page Home at "/"
  state count: int = 0
  state page: int = 1

  section .surface-canvas .content-content
    badge variant=soft "Korlix V2"
    h1 "Build websites with one readable language"
    p "HTML, Korlix-native colors, components, state, pagination and API calls."

    row
      button "Count: {count}" variant=primary click=increment
      button "Reset" variant=ghost click=reset

  grid .tablet:grid-cols-2 .desktop:grid-cols-3
    feature-card title="Modern HTML" description="Use semantic HTML tags directly."
    feature-card title="Theme aware" description="Light, dark and automatic modes are built in."
    feature-card title="100+ components" description="Cards, navigation, forms, overlays and data UI."

  card variant=outline
    h2 "Pagination"
    pagination page=page pages=12 url-sync

  card variant=soft
    h2 "API example"
    p "The query below exposes users.data, users.loading, users.error and users.reload()."
    get users "/api/users"

  fn increment
    count += 1

  fn reset
    count = 0
