import ShowcaseLayout from "./layouts/showcase-layout.klx"

app KorlixCompleteShowcase
  layout ShowcaseLayout
  theme auto

  providers
    toast
    modal
    theme

  routes
    page "/" from "./pages/index.klx"
    page "/language" from "./pages/language.klx"
    page "/native-elements" from "./pages/native-elements.klx"
    page "/styling" from "./pages/styling.klx"
    page "/components" from "./pages/components.klx"
    page "/forms" from "./pages/forms.klx"
    page "/state-events" from "./pages/state-events.klx"
    page "/api" from "./pages/api.klx"
    page "/overlays" from "./pages/overlays.klx"
    page "/pagination" from "./pages/pagination.klx"
    page "/themes" from "./pages/themes.klx"
