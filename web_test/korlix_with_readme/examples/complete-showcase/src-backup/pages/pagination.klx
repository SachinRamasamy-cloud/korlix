import SectionTitle from "../components/showcase-section-title.klx"
import CodePanel from "../components/showcase-code.klx"
import Feature from "../components/showcase-feature.klx"

page PaginationExamples at "/pagination"
  meta
    title "Korlix Pagination"
    description "First, previous, numbered, next and last controls with URL synchronization and change events."

  state currentPage: int = 1
  state totalRecords: int = 95
  state pageSize: int = 10
  state lastChange: string = "Page 1"

  section .px-6 .py-12
    container size=full
      SectionTitle eyebrow="Data navigation" title="Pagination with one component" description="The runtime calculates page counts, renders boundary controls, dispatches change events and optionally synchronizes the page to the URL."

      grid .grid-cols-1 .lg:grid-cols-2 .gap-8
        CodePanel title="Total-record mode" codeText="pagination page=currentPage total=95 perPage=10 siblings=2 url-sync"
        CodePanel title="State integration" codeText="pagination page=currentPage total=95 on:change:\n  currentPage = event.detail.page"

  section .surface-raised .px-6 .py-12
    container size=full
      card variant=raised
        row .items-center .justify-between .gap-4
          div
            h2 "Interactive pagination"
            p .content-content-muted "The change event updates currentPage from event.detail.page."
          badge variant=primary "Page {currentPage}"

        pagination page=currentPage total=totalRecords perPage=pageSize siblings=2 url-sync on:change:
          currentPage = event.detail.page
          lastChange = "Pagination changed"

        dl .grid .grid-cols-2 .md:grid-cols-4 .gap-4 .mt-6
          div
            dt "Current page"
            dd currentPage
          div
            dt "Total records"
            dd totalRecords
          div
            dt "Page size"
            dd pageSize
          div
            dt "Last event"
            dd lastChange

        row .flex-wrap .gap-3 .mt-6
          btn variant=ghost click=resetPage "Reset to page 1"
          btn variant=secondary click=increaseTotal "Add records"
          btn variant=outline click=decreaseTotal "Remove records"

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Pagination behavior"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-3 .gap-5 .mt-6
        Feature title="Boundary controls" description="First, previous, next and last buttons disable automatically at boundaries."
        Feature title="Number window" description="The siblings property controls how many adjacent page numbers are visible."
        Feature title="Ellipsis" description="The runtime inserts ellipsis when page ranges are omitted."
        Feature title="Accessibility" description="Buttons receive descriptive labels and the active page uses aria-current."
        Feature title="URL synchronization" description="url-sync stores the active page in the browser query string."
        Feature title="Custom events" description="The component emits change and kx:page-change with page and pages detail."

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Additional configurations"
      grid .grid-cols-1 .lg:grid-cols-2 .gap-6 .mt-6
        card variant=outline
          h3 "Compact range"
          pagination page=5 total=240 perPage=20 siblings=1
        card variant=outline
          h3 "Wide range"
          pagination page=8 total=500 perPage=10 siblings=3

      alert type=info title="Current integration rule"
        p "Pagination emits events but does not automatically assign a Korlix state variable unless an event handler is attached."

  fn resetPage
    currentPage = 1
    lastChange = "Reset to page 1"

  fn increaseTotal
    totalRecords += 10
    lastChange = "Added ten records"

  fn decreaseTotal
    if totalRecords > 10
      totalRecords -= 10
      lastChange = "Removed ten records"
