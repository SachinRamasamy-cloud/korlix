import SectionTitle from "../components/showcase-section-title.klx"

page Forms at "/forms"
  meta
    title "Korlix Forms"
    description "Native form elements, Korlix form components, Boolean attributes, input events and validation states."

  state name: string = "Maya Patel"
  state email: string = "maya@example.com"
  state role: string = "Frontend Developer"
  state notifications: bool = true
  state submitted: bool = false

  section .px-6 .py-12
    container size=full
      SectionTitle eyebrow="Forms and validation" title="Build accessible forms with native and Korlix components" description="Form elements accept ordinary HTML attributes, Boolean properties and Korlix event handlers."

      grid .grid-cols-1 .xl:grid-cols-2 .gap-8
        form .surface-raised .outline-outline .border .rounded-xl .p-6
          h2 .text-2xl .font-semibold "Interactive profile form"
          p .content-content-muted "Input events update reactive Korlix state through the DOM event object."

          form-group .mt-5
            label for="profile-name" "Name"
            input id="profile-name" type="text" value=name placeholder="Full name" autocomplete="name" required on:input:
              name = event.target.value

          form-group .mt-5
            label for="profile-email" "Email"
            input id="profile-email" type="email" value=email placeholder="name@example.com" autocomplete="email" required on:input:
              email = event.target.value

          form-group .mt-5
            label for="profile-role" "Role"
            select id="profile-role" value=role
              option value="Frontend Developer" selected "Frontend Developer"
              option value="Compiler Engineer" "Compiler Engineer"
              option value="Documentation Author" "Documentation Author"

          form-group .mt-5
            label
              input type="checkbox" checked=notifications on:change:
                notifications = event.target.checked
              span " Enable notifications"

          row .flex-wrap .gap-3 .mt-6
            btn variant=primary type="button" click=submitProfile "Save profile"
            btn variant=ghost type="reset" click=resetProfile "Reset"

          if submitted
            alert type=success title="Saved"
              p "The form state was handled by a Korlix function."

        card variant=outline
          h2 .text-2xl .font-semibold "Reactive preview"
          profile-card name=name role=role bio=email
          dl .mt-5
            dt "Notifications"
            if notifications
              dd "Enabled"
            else
              dd "Disabled"

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Native input types"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-3 .gap-5 .mt-6
        form-field
          label "Text"
          input type="text" placeholder="Text input"
        form-field
          label "Number"
          input type="number" min=0 max=100 step=1 value=42
        form-field
          label "Password"
          input type="password" minlength=8 placeholder="Password"
        form-field
          label "Email"
          input type="email" placeholder="name@example.com"
        form-field
          label "Search"
          input type="search" placeholder="Search"
        form-field
          label "URL"
          input type="url" placeholder="https://example.com"
        form-field
          label "Telephone"
          input type="tel" placeholder="+91 98765 43210"
        form-field
          label "Date"
          input type="date"
        form-field
          label "Time"
          input type="time"
        form-field
          label "Color"
          input type="color" value="#7457f5"
        form-field
          label "Range"
          input type="range" min=0 max=100 value=65
        form-field
          label "File"
          input type="file" accept="image/*" multiple

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Korlix form component catalogue"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-3 .gap-5 .mt-6
        text-field
          strong "text-field"
          input type="text" placeholder="Text"
        number-field
          strong "number-field"
          input type="number" value=10
        password-field
          strong "password-field"
          input type="password" placeholder="Password"
        email-field
          strong "email-field"
          input type="email" placeholder="Email"
        search-box
          strong "search-box"
          input type="search" placeholder="Search"
        textarea-field
          strong "textarea-field"
          textarea rows=4 placeholder="Long text"
        select-field
          strong "select-field"
          select
            option value="one" "One"
            option value="two" "Two"
        multi-select "multi-select"
        checkbox-group
          legend "checkbox-group"
          checkbox label="First" checked=true
          checkbox label="Second"
        radio-group
          legend "radio-group"
          radio "First"
          radio "Second"
        switch label="switch" checked=true
        slider "slider"
        range-slider "range-slider"
        date-picker "date-picker"
        time-picker "time-picker"
        file-upload "file-upload"
        dropzone "dropzone"
        color-picker "color-picker"
        otp-input "otp-input"
        form-group "form-group"
        form-field "form-field"
        field-error "field-error"

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Boolean attributes"
      p .content-content-muted "The parser recognizes common Boolean properties without requiring =true."
      grid .grid-cols-1 .md:grid-cols-2 .gap-5 .mt-6
        card
          h3 "Enabled controls"
          input type="text" autofocus required placeholder="Required and autofocus"
          input type="checkbox" checked
          select multiple
            option selected "Selected option"
        card
          h3 "Disabled and read-only controls"
          input type="text" disabled value="Disabled"
          input type="text" readonly value="Read only"
          button disabled "Disabled button"

  fn submitProfile
    submitted = true
    toast("success", "Profile saved")
    log(name, email, role)

  fn resetProfile
    name = "Maya Patel"
    email = "maya@example.com"
    role = "Frontend Developer"
    notifications = true
    submitted = false
