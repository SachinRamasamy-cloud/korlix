import SectionTitle from "../components/showcase-section-title.klx"

page Overlays at "/overlays"
  meta
    title "Korlix Feedback and Overlays"
    description "Toast notifications, alerts, modals, drawers, tooltips and generic overlay components."

  state lastAction: string = "No overlay action yet"

  section .px-6 .py-12
    container size=full
      SectionTitle eyebrow="Runtime modules" title="Feedback and overlay interactions" description="Specialized components emit runtime hooks for toast notifications, modals and drawers. Generic overlay components provide semantic shells for future specialization."

      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-4 .gap-5
        alert type=info title="Information"
          p "Informational alert content"
        alert type=success title="Success"
          p "Successful operation"
        alert type=warning title="Warning"
          p "Attention is required"
        alert type=error title="Error" dismissible=true
          p "An operation failed"

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Toast notifications"
      row .flex-wrap .gap-3 .mt-6
        btn variant=primary click=successToast "Success toast"
        btn variant=danger click=errorToast "Error toast"
        btn variant=secondary click=warningToast "Warning toast"
        btn variant=ghost click=infoToast "Info toast"
        btn variant=outline click=loadingToast "Loading toast"

      grid .grid-cols-1 .md:grid-cols-2 .gap-5 .mt-6
        notification
          strong "Persistent notification"
          p "Unlike a toast, this generic component remains in document flow."
        result-state
          strong "Result state"
          p lastAction

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Modal and drawer"
      row .flex-wrap .gap-3 .mt-6
        btn variant=primary click=openWelcomeModal "Open modal"
        btn variant=secondary click=openNavigationDrawer "Open drawer"

      modal id="welcome-modal" title="Korlix modal" size=lg closable=true
        h3 "Specialized modal content"
        p "The generated element includes dialog semantics, backdrop behavior, escape handling and focus restoration."
        row .gap-3 .mt-5
          btn variant=primary click=confirmModal "Confirm"
          btn variant=ghost click=closeWelcomeModal "Cancel"

      drawer id="navigation-drawer" side="right" title="Korlix drawer"
        nav-list
          nav-item href="/language" "Language"
          nav-item href="/components" "Components"
          nav-item href="/api" "API"
        btn variant=primary click=closeNavigationDrawer "Close drawer"

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Tooltip and generic overlay catalogue"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-3 .gap-5 .mt-6
        card
          h3 "tooltip"
          tooltip content="Helpful contextual information" placement="top"
            btn variant=ghost "Hover target"
        popover
          h3 "popover"
          p "Anchored overlay shell"
        dropdown
          h3 "dropdown"
          list-group
            list-item "First action"
            list-item "Second action"
        context-menu
          li "Copy"
          li "Rename"
          li "Delete"
        confirm-dialog
          h3 "confirm-dialog"
          p "Confirmation dialog semantic shell"
        lightbox
          image src="/assets/korlix-demo.svg" alt="Lightbox image"
        sheet
          h3 "sheet"
          p "Edge sheet overlay shell"

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Overlay behavior currently implemented"
      table striped=true hoverable=true .mt-6
        thead
          tr
            th "Feature"
            th "Status"
        tbody
          tr
            td "Modal open and close"
            td "Implemented"
          tr
            td "Escape and backdrop close"
            td "Implemented"
          tr
            td "Focus restoration"
            td "Implemented"
          tr
            td "Drawer left or right"
            td "Implemented"
          tr
            td "Full focus trapping and overlay stack"
            td "Planned"

  fn successToast
    toast("success", "Operation completed")
    lastAction = "Success toast shown"

  fn errorToast
    toast("error", "Operation failed")
    lastAction = "Error toast shown"

  fn warningToast
    toast("warning", "Check the current configuration")
    lastAction = "Warning toast shown"

  fn infoToast
    showToast("info", "Korlix runtime information")
    lastAction = "Info toast shown"

  fn loadingToast
    toast("loading", "Compiling project")
    lastAction = "Loading toast shown"

  fn openWelcomeModal
    openModal("welcome-modal")
    lastAction = "Modal opened"

  fn closeWelcomeModal
    closeModal("welcome-modal")
    lastAction = "Modal closed"

  fn confirmModal
    closeModal("welcome-modal")
    toast("success", "Modal confirmed")
    lastAction = "Modal confirmed"

  fn openNavigationDrawer
    openDrawer("navigation-drawer")
    lastAction = "Drawer opened"

  fn closeNavigationDrawer
    closeDrawer("navigation-drawer")
    lastAction = "Drawer closed"
