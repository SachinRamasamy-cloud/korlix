import SectionTitle from "../components/showcase-section-title.klx"

page Components at "/components"
  meta
    title "Korlix Component Catalogue"
    description "Specialized and generic Korlix components across navigation, forms, content, overlays, data, media and layout."

  section .px-6 .py-12
    container size=full
      SectionTitle eyebrow="115 registered names" title="The complete Korlix component catalogue" description="Thirty-five components have dedicated schemas. Eighty additional names use the generic schema-driven renderer and can be specialized further without changing source syntax."

      alert type=warning title="Maturity distinction"
        p "Registered does not mean every component already has complete interaction behavior. This page shows the current semantic output surface."

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Specialized primitives and content"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-4 .gap-5 .mt-6
        card variant=elevated
          h3 "btn"
          row .flex-wrap .gap-2
            btn variant=primary "Primary"
            btn variant=secondary "Secondary"
            btn variant=ghost "Ghost"
            btn variant=danger "Danger"
        card variant=outline
          h3 "link and icon"
          link href="/" "Internal link"
          link href="https://example.com" external=true "External link"
          icon name="code" label="Code icon" size=lg
        card
          h3 "image"
          image src="/assets/korlix-demo.svg" alt="Korlix sample" width=320 height=180 fit="cover"
        card
          h3 "avatar and badge"
          row .items-center .gap-3
            avatar name="Sachin Ramasamy" status="online" size=lg
            badge variant=success "Online"
        card
          h3 "alert"
          alert type=info title="Information" dismissible=true
            p "Alerts accept title, type and slot content."
        card
          h3 "loaders"
          row .items-center .gap-4
            spinner size=sm color=primary
            spinner size=md color=success
          skeleton width="100%" height="1rem" rounded=true
          skeleton-card count=1 lines=3
          skeleton-grid count=4
        card
          h3 "empty state"
          empty-state icon="inbox" title="No projects" description="Create a project to begin."
        card
          h3 "progress"
          progress value=68 max=100 label=true

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Navigation components"
      grid .grid-cols-1 .lg:grid-cols-2 .gap-6 .mt-6
        card variant=outline
          navbar sticky=false transparent=false
            strong "Navbar"
            nav .flex .gap-3
              link href="/" "Home"
              link href="/components" active=true "Components"
        card variant=outline
          sidebar collapsed=false width="220px"
            strong "Sidebar"
            nav-list
              nav-item href="/language" "Language"
              nav-item href="/styling" "Styling"
              nav-group "Resources"
        card variant=outline
          breadcrumb items=[{ label: "Home", href: "/" }, { label: "Components", href: "/components" }] separator=">"
          tabs active="overview" variant=pills
            btn variant=ghost "Overview"
            btn variant=ghost "Props"
            btn variant=ghost "Events"
        card variant=outline
          stepper
            step variant=complete "Create"
            step variant=active "Develop"
            step "Build"
          command-menu "Command menu"
          mobile-menu "Mobile menu"
          bottom-navigation "Bottom navigation"

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Content and marketing components"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-3 .gap-5 .mt-6
        product-card variant=raised
          image src="/assets/korlix-demo.svg" alt="Product"
          h3 "Product card"
          p "E-commerce summary surface"
        stat-card variant=soft
          small "Build time"
          strong .text-3xl "42 ms"
        pricing-card variant=outline
          h3 "Community"
          p "Open-source compiler"
          strong "Free"
        article-card
          h3 "Compiler architecture"
          p "Read the latest design article."
        testimonial-card
          blockquote "The syntax keeps intent visible."
          figcaption "Korlix developer"
        feature-card
          h3 "Feature card"
          p "Reusable marketing content."
        image-card
          image src="/assets/korlix-demo.svg" alt="Image card"
          figcaption "Image-focused content"
        profile-card name="Maya Patel" role="Frontend Developer" bio="Builds Korlix user interfaces."
        avatar-group
          avatar name="Maya Patel"
          avatar name="Aarav Sharma"
          avatar name="Noah Williams"

      grid .grid-cols-1 .lg:grid-cols-2 .gap-5 .mt-6
        timeline
          timeline-item
            strong "Lexer"
            p "Source becomes tokens."
          timeline-item
            strong "Parser"
            p "Tokens become an AST."
          timeline-item
            strong "Code generation"
            p "AST becomes browser output."
        accordion multiple=true
          accordion-item open
            summary "What is Korlix?"
            p "A frontend-first language and compiler."
          accordion-item
            summary "What does it generate?"
            p "HTML, CSS and JavaScript."

      row .flex-wrap .gap-3 .mt-6
        tag "language"
        chip "compiler"
        badge variant=soft "component"
        status-indicator variant=success "stable"

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Form components"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-3 .gap-5 .mt-6
        text-field
          span "Text field"
          input type="text" placeholder="Name"
        number-field
          span "Number field"
          input type="number" value=10
        password-field
          span "Password field"
          input type="password" placeholder="Password"
        email-field
          span "Email field"
          input type="email" placeholder="name@example.com"
        search-box
          span "Search box"
          input type="search" placeholder="Search components"
        textarea-field
          span "Textarea field"
          textarea rows=3 placeholder="Message"
        select-field
          span "Select field"
          select
            option value="one" "One"
            option value="two" "Two"
        multi-select "Multi select"
        checkbox-group
          legend "Checkbox group"
          checkbox label="Documentation" checked=true
          checkbox label="Examples"
        radio-group
          legend "Radio group"
          radio "Light"
          radio "Dark"
        switch label="Enable notifications" checked=true
        slider "Slider"
        range-slider "Range slider"
        date-picker "Date picker"
        time-picker "Time picker"
        file-upload "File upload"
        dropzone "Drop files here"
        color-picker "Color picker"
        otp-input "OTP input"
        form-group "Form group"
        form-field "Form field"
        field-error "This field is required."

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Feedback and overlays"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-3 .gap-5 .mt-6
        toast type=success message="Static toast preview" duration=0 position="top-right"
        notification
          strong "Notification"
          p "Persistent feedback surface"
        progress-bar "Progress bar"
        progress-circle "Progress circle"
        result-state
          strong "Operation completed"
        tooltip content="Tooltip content" placement="top"
          btn variant=ghost "Hover target"
        popover "Popover"
        dropdown "Dropdown"
        context-menu "Context menu"
        confirm-dialog "Confirm dialog"
        lightbox "Lightbox"
        sheet "Sheet"

      row .flex-wrap .gap-3 .mt-6
        btn variant=primary click=openComponentModal "Open modal"
        btn variant=secondary click=openComponentDrawer "Open drawer"
        btn variant=ghost click=showComponentToast "Show toast"

      modal id="component-modal" title="Specialized modal" size=md closable=true
        p "Modal content is rendered into an accessible dialog surface."
        btn variant=primary click=closeComponentModal "Close modal"

      drawer id="component-drawer" side="right" title="Specialized drawer"
        p "Drawers can open from the left or right."
        btn variant=primary click=closeComponentDrawer "Close drawer"

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Data display components"
      grid .grid-cols-1 .lg:grid-cols-2 .gap-5 .mt-6
        data-table
          table
            thead
              tr
                th "Name"
                th "Status"
            tbody
              tr
                td "Compiler"
                td "Stable"
        data-grid "Interactive data grid shell"
        tree-view
          li "src"
          li "docs"
          li "examples"
        calendar "Calendar"
        chart-container
          figcaption "Chart container"
          div .h-[160px] .surface-violet-2 .rounded-lg
        metric
          small "Components"
          strong .text-3xl "115"
        key-value-list
          dt "Extension"
          dd ".klx"
          dt "Compiler"
          dd "Rust"
        code-block "page Home at \"/\""

      pagination page=2 total=120 perPage=10 siblings=1 url-sync

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Media and layout components"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-3 .gap-5 .mt-6
        carousel "Carousel"
        gallery
          image src="/assets/korlix-demo.svg" alt="Gallery item"
        image-viewer
          image src="/assets/korlix-demo.svg" alt="Image viewer"
        video-player "Video player"
        audio-player "Audio player"
        map-container "Map container"

      container size=full .mt-8
        row .gap-4
          card "row item"
          card "row item"
        column .gap-3 .mt-4
          card "column item"
          card "column item"
        grid .grid-cols-1 .md:grid-cols-3 .gap-4 .mt-4
          card "grid item"
          card "grid item"
          card "grid item"
        stack .gap-3 .mt-4
          badge "stack item"
          badge "stack item"
        split .mt-4
          card "left panel"
          card "right panel"
        divider
        spacer .h-6
        scroll-area .h-[120px] .overflow-y-auto .surface-surface .rounded-lg .p-4
          p "Scrollable content line 1"
          p "Scrollable content line 2"
          p "Scrollable content line 3"
          p "Scrollable content line 4"
        theme-toggle

  fn openComponentModal
    openModal("component-modal")

  fn closeComponentModal
    closeModal("component-modal")

  fn openComponentDrawer
    openDrawer("component-drawer")

  fn closeComponentDrawer
    closeDrawer("component-drawer")

  fn showComponentToast
    toast("success", "Component toast triggered")
