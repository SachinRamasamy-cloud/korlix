component showcase-feature
  prop title: string
  prop description: string
  prop status: string = "stable"

  article .surface-raised .outline-outline .border .rounded-xl .p-5 .shadow-sm
    row .items-start .justify-between .gap-4
      h3 .text-lg .font-semibold title
      badge variant=status status
    p .content-content-muted description
    slot
