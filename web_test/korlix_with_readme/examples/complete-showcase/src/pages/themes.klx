import SectionTitle from "../components/showcase-section-title.klx"
import CodePanel from "../components/showcase-code.klx"

page Themes at "/themes"
  meta
    title "Korlix Light and Dark Themes"
    description "Light, dark and automatic theme modes, semantic tokens and the theme runtime."

  state selectedMode: string = "auto"

  section .px-6 .py-12
    container size=full
      SectionTitle eyebrow="Theme runtime" title="Light, dark and system mode" description="The application uses theme auto. The runtime stores manual preference, follows the operating-system theme and updates data-kx-theme without a reload."

      grid .grid-cols-1 .lg:grid-cols-2 .gap-8
        CodePanel title="Application configuration" codeText="app MyApplication\n  theme auto"
        CodePanel title="Runtime controls" codeText="theme-toggle\nbutton \"Toggle theme\" click=changeTheme"

      row .flex-wrap .items-center .gap-3 .mt-6
        theme-toggle aria-label="Toggle Korlix theme"
        btn variant=primary click=changeTheme "Toggle theme"
        badge variant=soft "Action: {selectedMode}"

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Semantic token preview"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-4 .gap-5 .mt-6
        card .surface-canvas .content-content .outline-outline .border
          strong "Canvas"
          p .content-content-muted "Application background token"
        card .surface-surface .content-content .outline-outline .border
          strong "Surface"
          p .content-content-muted "Standard surface token"
        card .surface-raised .content-content .outline-outline .border
          strong "Raised"
          p .content-content-muted "Elevated surface token"
        card .surface-overlay .content-content .outline-outline .border
          strong "Overlay"
          p .content-content-muted "Modal and popover surface"
        card .surface-brand .text-white
          strong "Brand"
          p "Primary action token"
        card .surface-success .text-white
          strong "Success"
          p "Positive status token"
        card .surface-warning .content-neutral-12
          strong "Warning"
          p "Attention token"
        card .surface-danger .text-white
          strong "Danger"
          p "Destructive token"

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Theme-aware component"
      card .bg-white .content-neutral-12 .dark:surface-neutral-11 .dark:content-neutral-1 .outline-neutral-3 .dark:outline-neutral-9 .border .rounded-xl .p-6 .mt-6
        row .items-center .justify-between
          div
            h3 "One source definition"
            p .content-content-muted "Dark variants modify only the values that need an explicit override."
          avatar name="KL" status="online"
        row .flex-wrap .gap-3 .mt-5
          btn .surface-violet-7 .text-white .hover:surface-violet-8 "Primary action"
          btn .surface-neutral-1 .dark:surface-neutral-9 .outline-outline .border "Secondary action"

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Runtime behavior"
      table striped=true hoverable=true .mt-6
        thead
          tr
            th "Capability"
            th "Implementation"
        tbody
          tr
            td "Mode values"
            td "light, dark and auto"
          tr
            td "Document marker"
            td "data-kx-theme"
          tr
            td "Browser integration"
            td "color-scheme"
          tr
            td "Persistence"
            td "localStorage"
          tr
            td "System changes"
            td "prefers-color-scheme listener"
          tr
            td "Notification"
            td "kx:theme-change event"

      alert type=warning title="Known implementation issue"
        p "The initial bootstrap and main runtime currently use different local-storage key names. The project documentation records this as a defect to correct."

  fn changeTheme
    toggleTheme()
    selectedMode = "theme toggled"
