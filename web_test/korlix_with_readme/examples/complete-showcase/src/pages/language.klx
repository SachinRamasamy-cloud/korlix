import CodePanel from "../components/showcase-code.klx"
import Person from "../components/showcase-person.klx"
import SectionTitle from "../components/showcase-section-title.klx"

page Language at "/language"
  meta
    title "Korlix Language Features"
    description "Applications, pages, components, props, state, expressions, functions, conditions and loops."

  state selectedName: string = "Maya"
  state score: number = 84.5
  state enabled: bool = true
  state tags = ["compiler", "frontend", "language"]
  state profile = { name: "Maya Patel", role: "Frontend Developer", active: true }
  state team = [{ name: "Maya Patel", role: "Frontend Developer", active: true }, { name: "Aarav Sharma", role: "Compiler Engineer", active: true }, { name: "Noah Williams", role: "Documentation Author", active: false }]
  let staticValue: int = 20
  derived scorePercent = score / 100

  section .px-6 .py-12
    container size=full
      SectionTitle eyebrow="Language reference" title="Core Korlix syntax in one project" description="This page demonstrates declarations, values, expressions, user components, control flow and functions using the V2 indentation-first syntax."

      grid .grid-cols-1 .lg:grid-cols-2 .gap-8
        CodePanel title="Application and page" codeText="app MyApp\n  layout MainLayout\n  theme auto\n\npage Home at \"/\"\n  h1 \"Hello Korlix\""
        CodePanel title="Imports and mount" codeText="import App from \"./app.klx\"\nimport UserCard from \"./components/user-card.klx\"\nmount App to \"#korlix-root\""

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Values and expressions"
      p .content-content-muted "Korlix supports strings, numbers, booleans, null, lists, records, arithmetic, comparison, logical operations, member access, indexing and calls."

      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-4 .gap-4 .mt-6
        stat-card
          small "String"
          strong selectedName
        stat-card
          small "Number"
          strong score
        stat-card
          small "Boolean"
          strong enabled
        stat-card
          small "Indexed list value"
          strong tags[0]

      card variant=outline .mt-6
        h3 "Record member access and interpolation"
        p "{profile.name} works as a {profile.role}."
        p "Current score: {score}"

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Typed reusable components"
      p .content-content-muted "Props without defaults are required. Props with defaults are optional. Slot content is inserted into the component body."

      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-3 .gap-5 .mt-6
        for member in team
          Person name=member.name role=member.role active=member.active
            row .gap-2 .mt-4
              btn variant=ghost size=sm click=selectMaya "Select"
              badge variant=soft "Slot content"

      CodePanel title="User component declaration" codeText="component showcase-person\n  prop name: string\n  prop role: string = \"Korlix Developer\"\n  prop active: bool = true\n\n  article\n    h3 name\n    p role\n    slot"

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Conditions, loops and functions"

      grid .grid-cols-1 .lg:grid-cols-2 .gap-6 .mt-6
        card variant=raised
          h3 "Condition"
          if enabled and score >= 80
            alert type=success title="Condition passed"
              p "The interface is enabled and the score is at least 80."
          else
            alert type=warning title="Condition did not pass"
              p "Change the state to render the alternative branch."

          row .gap-3 .mt-4
            btn variant=primary click=toggleEnabled "Toggle enabled"
            btn variant=secondary click=addScore "Add score"

        card variant=outline
          h3 "Loop"
          ul .mt-4
            for tagName in tags
              li .py-2 .border-b .outline-outline
                code tagName

      CodePanel title="Functions and local values" codeText="fn addScore(amount: number)\n  let next = score + amount\n  score = next\n\naction resetScore\n  score = 0"

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Supported operator examples"
      table striped=true hoverable=true .mt-6
        thead
          tr
            th "Category"
            th "Operators"
            th "Example"
        tbody
          tr
            td "Arithmetic"
            td "+ - * / %"
            td "score + 5"
          tr
            td "Comparison"
            td "== != < <= > >="
            td "score >= 80"
          tr
            td "Logical"
            td "and or not, && || !"
            td "enabled and score > 0"
          tr
            td "Assignment"
            td "= += -="
            td "score += 5"

  fn toggleEnabled
    enabled = !enabled

  fn addScore
    let amount: number = 5
    score = score + amount
    toast("success", "Score increased")

  action resetScore
    score = 0

  fn selectMaya
    selectedName = "Maya"
    log("Selected Maya")
