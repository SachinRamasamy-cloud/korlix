import SectionTitle from "../components/showcase-section-title.klx"
import CodePanel from "../components/showcase-code.klx"

page StateEvents at "/state-events"
  meta
    title "Korlix State, Functions and Events"
    description "Reactive state, expressions, control flow, functions and browser event handling in Korlix."

  state count: int = 0
  state active: bool = true
  state lastEvent: string = "No event yet"
  state selectedIndex: int = 0
  state values = [2, 4, 6, 8]
  state user = { name: "Maya", role: "Developer" }
  state nullableValue = null
  derived total = count * 2

  section .px-6 .py-12
    container size=full
      SectionTitle eyebrow="Browser behavior" title="Reactive state, functions and event handlers" description="Korlix compiles state declarations into a Proxy-based runtime and emits event descriptors for browser interaction."

      grid .grid-cols-1 .lg:grid-cols-2 .gap-6
        card variant=raised
          h2 "Reactive values"
          dl .mt-4
            dt "Count"
            dd count
            dt "Active"
            dd active
            dt "Record member"
            dd user.name
            dt "List index"
            dd values[selectedIndex]
            dt "Null value"
            dd nullableValue

          row .flex-wrap .gap-3 .mt-5
            btn variant=primary click=increment "Increase"
            btn variant=secondary click=decrement "Decrease"
            btn variant=ghost click=toggleActive "Toggle active"
            btn variant=outline click=selectNext "Next list value"

          if active and count >= 0
            alert type=success title="Condition is true"
              p "Active is true and count is non-negative."
          else
            alert type=warning title="Condition is false"
              p "One or more conditions did not pass."

        card variant=outline
          h2 "Current event"
          p .text-2xl .font-semibold .mt-4 lastEvent
          p .content-content-muted "Use the event controls below and watch this value update."
          row .gap-3 .mt-5
            btn variant=primary click=copyCurrentEvent "Copy event name"
            btn variant=ghost click=writeLog "Write console log"

  section .surface-raised .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Supported event properties"
      grid .grid-cols-1 .md:grid-cols-2 .xl:grid-cols-4 .gap-4 .mt-6
        btn click=recordClick "click"
        btn double-click=recordDoubleClick "double-click"
        input type="text" placeholder="input event" input=recordInput
        select change=recordChange
          option "change event"
          option "second value"
        input type="text" placeholder="focus and blur" focus=recordFocus blur=recordBlur
        input type="text" placeholder="keydown and keyup" keydown=recordKeyDown keyup=recordKeyUp
        div .surface-violet-2 .rounded-lg .p-5 mouseenter=recordMouseEnter mouseleave=recordMouseLeave "mouseenter and mouseleave"
        div .surface-cyan-2 .rounded-lg .p-5 draggable=true drag=recordDrag drop=recordDrop "drag and drop"
        div .surface-emerald-2 .rounded-lg .p-5 touch-start=recordTouchStart touch-end=recordTouchEnd "touch events"
        div .h-[120px] .overflow-y-auto .surface-surface .rounded-lg .p-4 scroll=recordScroll
          p "scroll"
          p "scroll"
          p "scroll"
          p "scroll"
          p "scroll"
        img src="/assets/korlix-demo.svg" alt="Load event example" load=recordLoad error=recordError

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Inline legacy event block"
      p .content-content-muted "V1 on:event syntax remains accepted during migration."
      btn variant=secondary on:click:
        count += 1
        lastEvent = "legacy on:click"

  section .surface-raised .px-6 .py-12 id="event-log"
    container size=full
      h2 .text-3xl .font-bold "Functions, actions and local values"
      grid .grid-cols-1 .lg:grid-cols-2 .gap-6 .mt-6
        CodePanel title="Function with parameter" codeText="fn addAmount(amount: int)\n  let next = count + amount\n  count = next"
        CodePanel title="Control flow inside a function" codeText="fn inspectValues\n  for value in values\n    log(value)\n  if active\n    toast(\"success\", \"Active\")"

      row .flex-wrap .gap-3 .mt-6
        btn variant=primary click=addTen "Run local value function"
        btn variant=secondary click=inspectValues "Run loop and condition"
        btn variant=ghost click=resetState "Run action"

  section .px-6 .py-12
    container size=full
      h2 .text-3xl .font-bold "Built-in runtime calls"
      grid .grid-cols-2 .md:grid-cols-3 .xl:grid-cols-5 .gap-3 .mt-6
        btn variant=primary click=showSuccess "toast"
        btn variant=ghost click=copyExample "copyToClipboard"
        btn variant=ghost click=goToApi "navigate"
        btn variant=ghost click=goBackPage "goBack"
        btn variant=ghost click=changeTheme "toggleTheme"
        btn variant=ghost click=scrollToLog "scrollTo"
        btn variant=ghost click=writeLog "log"

  fn increment
    count += 1
    lastEvent = "click"

  fn decrement
    count -= 1
    lastEvent = "decrement"

  fn toggleActive
    active = !active
    lastEvent = "toggle"

  fn selectNext
    if selectedIndex >= 3
      selectedIndex = 0
    else
      selectedIndex += 1

  fn addTen
    let amount: int = 10
    let next = count + amount
    count = next
    lastEvent = "local let values"

  fn inspectValues
    for value in values
      log(value)
    if active
      toast("success", "Active state confirmed")
    else
      toast("warning", "Inactive state")

  action resetState
    count = 0
    active = true
    selectedIndex = 0
    lastEvent = "State reset"

  fn recordClick
    lastEvent = "click"

  fn recordDoubleClick
    lastEvent = "double-click"

  fn recordInput
    lastEvent = "input"

  fn recordChange
    lastEvent = "change"

  fn recordFocus
    lastEvent = "focus"

  fn recordBlur
    lastEvent = "blur"

  fn recordKeyDown
    lastEvent = "keydown"

  fn recordKeyUp
    lastEvent = "keyup"

  fn recordMouseEnter
    lastEvent = "mouseenter"

  fn recordMouseLeave
    lastEvent = "mouseleave"

  fn recordScroll
    lastEvent = "scroll"

  fn recordLoad
    lastEvent = "load"

  fn recordError
    lastEvent = "error"

  fn recordDrag
    lastEvent = "drag"

  fn recordDrop
    lastEvent = "drop"

  fn recordTouchStart
    lastEvent = "touch-start"

  fn recordTouchEnd
    lastEvent = "touch-end"

  fn copyCurrentEvent
    copyToClipboard(lastEvent)
    toast("success", "Event copied")

  fn showSuccess
    showToast("success", "Runtime dispatcher called")

  fn copyExample
    copyToClipboard("state count = 0")

  fn goToApi
    navigate("/api")

  fn goBackPage
    goBack()

  fn changeTheme
    toggleTheme()

  fn scrollToLog
    scrollTo("#event-log")

  fn writeLog
    log("Korlix state", count, active, lastEvent)
